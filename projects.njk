        <div class="main-button mt-3">
          <a href="/services/">View Our Services</a>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="call-to-action text-center text-light py-5">
  <div class="container">
    <h2 class="fw-bold mb-3">Need a Professional Valuation?</h2>
    <h4 class="fw-normal mb-4">Contact KWAADJEI VALUATION HUB for a tailored, defensible valuation report.</h4>
