            <i class="fa fa-university me-2 text-success"></i>Financial Institutions
          </h3>
          <ul class="list-unstyled m-0">
            <li><i class="fa fa-check-circle text-success me-2"></i> Savings and Loans Companies</li>
            <li><i class="fa fa-check-circle text-success me-2"></i> Co-operative Credit Unions</li>
            <li><i class="fa fa-check-circle text-success me-2"></i> Rural and Community Banks</li>
            <li><i class="fa fa-check-circle text-success me-2"></i> Commercial Banks</li>
            <li><i class="fa fa-check-circle text-success me-2"></i> Microfinance Institutions</li>
          </ul>
        </div>
      </div>

      <div class="col-md-6">
        <div class="client-card p-4 rounded-4 shadow-sm h-100">
          <h3 class="text-success fw-semibold mb-3">
            <i class="fa fa-building me-2 text-success"></i>Government & Public Bodies
          </h3>
          <ul class="list-unstyled m-0">
            <li><i class="fa fa-check-circle text-success me-2"></i> Judicial Institutions</li>
            <li><i class="fa fa-check-circle text-success me-2"></i> Land Administration Agencies</li>
            <li><i class="fa fa-check-circle text-success me-2"></i> Local Government Authorities</li>
            <li><i class="fa fa-check-circle text-success me-2"></i> Traditional Authorities</li>
          </ul>
        </div>
      </div>

      <div class="col-md-6">
        <div class="client-card p-4 rounded-4 shadow-sm h-100">
          <h3 class="text-success fw-semibold mb-3">
            <i class="fa fa-industry me-2 text-success"></i>Mining & Industrial Sector
          </h3>
          <ul class="list-unstyled m-0">
            <li><i class="fa fa-check-circle text-success me-2"></i> Mining Companies</li>
            <li><i class="fa fa-check-circle text-success me-2"></i> Mining Safety Institutes</li>
            <li><i class="fa fa-check-circle text-success me-2"></i> Industrial Operations</li>
            <li><i class="fa fa-check-circle text-success me-2"></i> Resource Exploration Firms</li>
          </ul>
        </div>
      </div>

      <div class="col-md-6">
        <div class="client-card p-4 rounded-4 shadow-sm h-100">
          <h3 class="text-success fw-semibold mb-3">
            <i class="fa fa-briefcase me-2 text-success"></i>Corporate & Private Sector
          </h3>        
          <ul class="list-unstyled m-0">
            <li><i class="fa fa-check-circle text-success me-2"></i> Educational Institutions</li>
            <li><i class="fa fa-check-circle text-success me-2"></i> Agricultural Companies</li>
            <li><i class="fa fa-check-circle text-success me-2"></i> Legal Firms</li>
            <li><i class="fa fa-check-circle text-success me-2"></i> Private Individuals</li>
            <li><i class="fa fa-check-circle text-success me-2"></i> Corporate Enterprises</li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</div>
<div class="experience-section py-5">
  <div class="container">
    <div class="row mb-5 text-center">
      <div class="col-lg-8 offset-lg-2">
        <h2 class="text-success">Our Experience in Action</h2>
        <p class="text-light">Selected engagements that showcase our expertise and client-focused approach.</p>
      </div>
    </div>

    <div class="row g-4">
      {% for item in [
        {title: "Resettlement & Compensation", subtitle: "Community Development Projects", location: "Nationwide", scope: "Advisory & Negotiation", details: ["Lead Consultant for Communities", "Negotiation with Mining Companies", "Resettlement Advisory"], icon: "users"},
        {title: "Road Diversion Advisory", subtitle: "Project Affected Persons", location: "Various Locations", scope: "Compensation Consulting", details: ["Government Infrastructure Projects", "Consultant to Affected Communities", "Compensation Advisory"], icon: "road"},
        {title: "Facility Management", subtitle: "Educational & Training Institutions", location: "Regional Centers", scope: "Property Management", details: ["Full Facility Management", "Maintenance & Operations", "Safety & Upkeep"], icon: "building"},
        {title: "Mining Sector Consultancy", subtitle: "Mining Companies", location: "Ashanti & Central Regions", scope: "Consultancy", details: ["Mining Operations Advisory", "Asset & Equipment Valuation", "Stakeholder Advisory"], icon: "industry"}
      ] %}
      <div class="col-md-6 col-lg-3">
        <div class="experience-card glass-card h-100">
          <h5 class="fw-bold mb-2 text-success">{{ item.title }}</h5>
          <p class="small"><i class="fa fa-{{ item.icon }} text-success"></i> {{ item.subtitle }}</p>
          <p class="small mb-2">{{ item.location }} <span class="text-secondary">/ {{ item.scope }}</span></p>
          <hr>
          <ul class="list-unstyled small mb-3">
            <li><strong>Assignment Scope:</strong></li>
            {% for d in item.details %}
            <li><i class="fa fa-check text-success"></i> {{ d }}</li>
            {% endfor %}
          </ul>
          <a href="/contact/" class="btn btn-success btn-sm w-100">Request Consultation</a>
        </div>
      </div>
      {% endfor %}
    </div>
  </div>
</div>

